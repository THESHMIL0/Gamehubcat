# Port for the server to listen on (Render automatically provides process.env.PORT)
PORT=3000

# Secret key used for signing session JSON Web Tokens (Change to a strong random key in production)
JWT_SECRET=gameroom_super_secret_jwt_key_production_ready

# SQLite Database storage path (defaults to ./gameroom.db)
DATABASE_PATH=gameroom.db

# Node Environment
NODE_ENV=production
